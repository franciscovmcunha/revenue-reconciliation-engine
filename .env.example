# Copy to .env and fill in real values — .env is git-ignored, never committed.

# PostgreSQL (bronze/silver/gold target)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=reconciliation
POSTGRES_USER=reconciliation
POSTGRES_PASSWORD=

# Azure AI Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Name (or regex) that identifies a sister-property deposit in a cash
# register "Descrição / Fornecedor" value — see
# docs/reconciliation_rules.md, "The inter-property deposit exception".
# Business-specific, not committed with a real value; the code's default
# ("sister-property") intentionally never matches real data until this is
# set.
SISTER_PROPERTY_MARKER=
