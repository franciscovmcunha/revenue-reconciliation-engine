# Copy to dbt/profiles.yml (gitignored) and set DBT_PROFILES_DIR=dbt, or
# copy to ~/.dbt/profiles.yml, dbt's default lookup location.

reconciliation:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('POSTGRES_HOST') }}"
      user: "{{ env_var('POSTGRES_USER') }}"
      password: "{{ env_var('POSTGRES_PASSWORD') }}"
      port: "{{ env_var('POSTGRES_PORT') | as_number }}"
      dbname: "{{ env_var('POSTGRES_DB') }}"
      schema: raw
      threads: 4
